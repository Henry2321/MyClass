# Leave these empty when the production client is served by the backend on the same domain.
VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_PEER_SERVER_URL=
VITE_PEER_PATH=/peerjs

# Optional TURN/STUN configuration for public internet voice/WebRTC.
# Keep it as a JSON array string.
# Example:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
VITE_ICE_SERVERS=
